{
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "jobpilot",
  "main": "src/index.ts",

  "compatibility_date": "2026-09-29",
  "compatibility_flags": ["nodejs_compat"],

  "ai": {
    "binding": "AI",
     "remote": true
  },

  "durable_objects": {
    "bindings": [
      {
        "name": "JobPilotAgent",
        "class_name": "JobPilotAgent"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["JobPilotAgent"]
    }
  ],

  "observability": {
    "enabled": true
  },

  "upload_source_maps": true
}